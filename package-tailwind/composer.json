{
    "name": "superbyte/ui-tailwind",
    "description": "Superbyte UI — a hand-crafted, zero-dependency, composable UI component library for Laravel + Livewire, built on the Tailwind CSS v4 design system.",
    "keywords": ["laravel", "livewire", "ui", "components", "blade", "tailwind", "tailwindcss", "tailwind-v4"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SuperbyteUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperbyteUi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SuperbyteUi\\SuperbyteUiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pestphp/pest-plugin-laravel": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
