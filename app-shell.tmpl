<!-- ═══ MODALS ═══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title"><span class="modal-icon"><i class="hgi-stroke hgi-folder-add"></i></span> New folder</div>
        <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="form-floating">
          <input class="form-control" id="create-name" placeholder="new-folder" autofocus>
          <label for="create-name">Folder name</label>
        </div>
        <div class="form-text mt-2">Folder names must be unique within the current directory.</div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" data-bs-dismiss="modal" onclick="showToast('success','Folder created')">Create</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title"><span class="modal-icon"><i class="hgi-stroke hgi-cloud-upload"></i></span> Upload files</div>
        <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="dropzone" style="border:2px dashed var(--border2);border-radius:var(--radius);padding:26px;text-align:center;color:var(--text3);font-size:13px">
          <i class="hgi-stroke hgi-cloud-upload d-block mb-2" style="font-size:22px"></i>
          Drop files here or click to browse<br><small style="font-size:11px">Max 50 MB per file</small>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" data-bs-dismiss="modal" onclick="showToast('success','Upload complete')">Upload</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-title"><span class="modal-icon danger"><i class="hgi-stroke hgi-alert-02"></i></span> Confirm delete</div>
        <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body"><p style="color:var(--text2);font-size:13px;margin:0">This action cannot be undone. The item will be permanently removed.</p></div>
      <div class="modal-footer">
        <button class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-danger" data-bs-dismiss="modal" onclick="showToast('success','Item deleted')">Delete</button>
      </div>
    </div>
  </div>
</div>

<!-- ═══ THEME CUSTOMIZER ═════════════════════════════════════════════════ -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="themeCustomizer">
  <div class="offcanvas-header">
    <div class="offcanvas-title"><i class="hgi-stroke hgi-paint-board"></i> Theme customizer</div>
    <button class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body">

    <div class="customizer-section">
      <div class="customizer-label">Appearance</div>
      <div class="appearance-grid">
        <div class="appearance-opt active" id="opt-dark" onclick="setAppearance('dark')"><i class="hgi-stroke hgi-moon-01"></i>Dark</div>
        <div class="appearance-opt" id="opt-light" onclick="setAppearance('light')"><i class="hgi-stroke hgi-sun-01"></i>Light</div>
      </div>
    </div>

    <div class="customizer-section">
      <div class="customizer-label">Accent color</div>
      <div class="swatch-grid" id="swatch-grid"></div>
    </div>

    <div class="customizer-section">
      <div class="customizer-label">Corner radius</div>
      <div class="radius-grid">
        <div class="radius-opt active" id="radius-sharp" onclick="setRadius('4px','2px',this)">Sharp</div>
        <div class="radius-opt" id="radius-default" onclick="setRadius('8px','4px',this)">Default</div>
        <div class="radius-opt" id="radius-round" onclick="setRadius('14px','8px',this)">Round</div>
      </div>
    </div>

    <div class="customizer-section">
      <div class="customizer-label">Layout density</div>
      <div class="appearance-grid">
        <div class="appearance-opt" id="opt-compact" onclick="setCompact(true)"><i class="hgi-stroke hgi-drag-02"></i>Compact</div>
        <div class="appearance-opt active" id="opt-roomy" onclick="setCompact(false)"><i class="hgi-stroke hgi-more-vertical"></i>Roomy</div>
      </div>
    </div>

    <div class="customizer-section">
      <div class="customizer-label">Content width</div>
      <div class="appearance-grid">
        <div class="appearance-opt active" id="opt-fluid" onclick="setBoxed(false)"><i class="hgi-stroke hgi-arrow-expand-01"></i>Fluid</div>
        <div class="appearance-opt" id="opt-boxed" onclick="setBoxed(true)"><i class="hgi-stroke hgi-arrow-shrink-01"></i>Boxed</div>
      </div>
    </div>

    <div class="customizer-section">
      <div class="customizer-label">Base font size</div>
      <input type="range" class="form-range" id="fs-range" min="13" max="17" value="14" oninput="setFontSize(this.value)">
      <div class="d-flex justify-content-between" style="font-size:10.5px;color:var(--text3);margin-top:4px"><span>13</span><span id="fs-out">14px</span><span>17</span></div>
    </div>

    <div class="customizer-section mb-0">
      <div class="customizer-label">Preview</div>
      <div class="card p-3 d-flex flex-column gap-2">
        <button class="btn btn-primary btn-sm">Primary button</button>
        <span class="tag tag-indigo" id="preview-tag"><i class="hgi-stroke hgi-circle"></i> Sample tag</span>
        <div class="progress"><div class="progress-bar" style="width:65%"></div></div>
      </div>
    </div>

  </div>
</div>

<script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
