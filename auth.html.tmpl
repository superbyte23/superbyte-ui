<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Superbyte UI — %AUTH_TITLE%</title>
<link rel="icon" href="../assets/img/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="../vendor/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="../vendor/hugeicons/css/hugeicons-used.css">
<link rel="stylesheet" href="../vendor/fonts.css">
<link rel="stylesheet" href="../assets/css/app.css">
<script src="../assets/js/theme-bootstrap.js"></script>

</head>
<body data-bs-theme="dark">

<!-- ═══ TOAST CONTAINER ═══════════════════════════════════════════════════ -->
<div id="toast-container"></div>

<!-- ═══ AUTH PAGE ═════════════════════════════════════════════════════════ -->
<div class="auth-page">
  <div class="auth-card">

    <div class="auth-logo">
      <div class="logo-mark"><i class="hgi-stroke hgi-flowchart-01"></i></div>
      Superbyte UI
      <span style="color:var(--text3);font-weight:400;font-size:11px">%AUTH_VERSION%</span>
    </div>

    <button class="icon-btn auth-theme-btn" onclick="toggleTheme()" title="Toggle theme"><i class="hgi-stroke hgi-moon-01" id="theme-icon"></i></button>

    <div class="auth-panel">
      <div class="auth-shield %AUTH_SHIELD%"><i class="hgi-stroke %AUTH_SHIELD_ICON%"></i></div>
      <h1>%AUTH_TITLE%</h1>
      <p class="sub">%AUTH_SUBTITLE%</p>

      %AUTH_FORM%

    </div>

    <div class="auth-foot">%AUTH_FOOT%</div>
    <div class="auth-legal">© 2026 Superbyte UI · <a href="#" onclick="showToast('success','Demo only')">Terms</a> · <a href="#" onclick="showToast('success','Demo only')">Privacy</a></div>

  </div>
</div>

<script src="../vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script>
%INLINE_AUTH_JS%
</script>
<script src="../assets/js/app.js"></script>
</body>
</html>
